{
  "name": "veridia-manufacturer-matching",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "dependencies": {
    "react": "^19.3.0", "react-dom": "^19.3.0", "zod": "^4.1.12", "papaparse": "^5.5.3"
  },
  "devDependencies": {
    "vite": "^8.3.0", "@vitejs/plugin-react": "^6.1.1", "typescript": "^5.9.3",
    "@types/react": "^19.3.0", "@types/react-dom": "^19.3.0", "@types/node": "^24.10.0", "@types/papaparse": "^5.3.16",
    "tailwindcss": "^4.3.3", "@tailwindcss/vite": "^4.3.3", "vitest": "^4.1.12", "@playwright/test": "^1.56.1",
    "tsx": "^4.20.6", "eslint": "^9.39.1", "@eslint/js": "^9.39.1", "typescript-eslint": "^8.46.2",
    "eslint-plugin-react-hooks": "^7.0.1", "eslint-plugin-react-refresh": "^0.4.24", "globals": "^16.5.0"
  },
  "scripts": {
    "data:prepare": "node --experimental-strip-types scripts/prepare-data.ts",
    "dev": "vite --configLoader native --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --configLoader native",
    "test:e2e": "playwright test",
    "build": "npm run data:prepare && npm run typecheck && vite build --configLoader native",
    "preview": "vite preview --configLoader native --host 127.0.0.1",
    "check": "npm run lint && npm test && npm run build && npm run test:e2e"
  }
}
